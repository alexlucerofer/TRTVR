{
  "manifest_version": 3,
  "name": "ELO — Vagas seguras",
  "version": "0.3.1",
  "description": "Analisa ofertas de emprego e mostra sinais de recrutamento enganoso, tráfico de pessoas e trabalho escravo, com fundamentos.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/rules.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ELO"
  },
  "options_page": "painel.html",
  "web_accessible_resources": [
    {
      "resources": [
        "data/seed.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
