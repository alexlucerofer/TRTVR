# ---- Extensão e plataforma (PÚBLICO — pode ir no navegador)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx_ou_eyJ...anon

# ---- Somente servidor (Edge Functions). O Supabase injeta SUPABASE_URL, SUPABASE_ANON_KEY
# e SUPABASE_SERVICE_ROLE_KEY automaticamente nas Edge Functions. NUNCA coloque a service role
# na extensão, na plataforma ou no Git.
SUPABASE_SERVICE_ROLE_KEY=nao-coloque-no-cliente

# Sal para o hash anti-abuso dos relatos (defina com: supabase secrets set REPORT_SALT=...)
REPORT_SALT=troque-por-um-valor-aleatorio

# ---- API ELO (Python, api/) — npm run api
# Chave da gestão (/v1/gestao/*: histórico, revisão, inscrições). Use um valor longo, principalmente com ngrok.
ELO_ADMIN_KEY=troque-por-uma-chave-longa
# Leitura de imagens com Claude Vision (opcional; sem ela usa Tesseract, ou a leitura "demo" dos panfletos da demo)
ANTHROPIC_API_KEY=
# ELO_VISION_MODEL=claude-opus-5-5
# Limite de análises por minuto por IP nas rotas públicas
# ELO_RATE_LIMIT=30
# 0 desliga as consultas públicas (RDAP, BrasilAPI, GLEIF)
# ELO_EXTERNAL=1
